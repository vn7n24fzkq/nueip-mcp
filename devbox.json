{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.7/.schema/devbox.schema.json",
  "packages": [
    "nodejs@20"
  ],
  "shell": {
    "init_hook": [
      "[ -f package-lock.json ] || npm install"
    ],
    "scripts": {
      "dev": "npm run dev",
      "build": "npm run build",
      "typecheck": "npm run typecheck"
    }
  }
}
