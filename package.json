{
  "name": "nueip-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server for nueip.com — clock in/out, attendance, leave, approval workflow.",
  "type": "module",
  "license": "MIT",
  "keywords": ["mcp", "nueip", "hr", "attendance", "claude"],
  "main": "dist/index.js",
  "bin": {
    "nueip-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test tests/format.test.ts tests/plan.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
